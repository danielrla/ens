# ==============================================================================
# .gitignore - Sistema ENS
# Ignora artefatos de build, dependências, arquivos de IDE, logs e dados locais
# ==============================================================================

# Compilação e Artefatos de Build (Java / Maven)
target
target/
**/target
**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Dependências e Compilação Frontend (Node / Angular)
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/.angular/
/tmp
/out-tsc
/bazel-out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Variáveis de Ambiente e Credenciais Locais
.env
.env.*
!.env.example

# Logs, Dumps e Diagnósticos
*.log
logs/
*.dump
*.hprof
*.stackdump

# IDEs e Editores
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~
.history/*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Arquivos do Sistema Operacional
.DS_Store
**/.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Arquivos Pessoais, Rascunhos e Documentos Locais
anotacoes.txt
git.md
*.draft
drafts/
.private/

# Caches Transitórios de Ferramentas e Grafos
graphify-out/cache/
graphify-out/converted/
